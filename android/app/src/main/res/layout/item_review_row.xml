<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReviewAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Ahmet Yılmaz" />

        <TextView
            android:id="@+id/tvReviewStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB800"
            android:textSize="13sp"
            tools:text="★★★★★" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/text_soft"
        android:textSize="12sp"
        tools:text="Harika bir mekan, kahveler ve ortam çok nezih. Kesinlikle tavsiye ederim." />
</LinearLayout>
