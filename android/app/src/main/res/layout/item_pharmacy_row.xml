<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvPharmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Yeni Hayat Eczanesi" />

    <TextView
        android:id="@+id/tvPharmAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_soft"
        android:textSize="12sp"
        tools:text="Bağdat Cad. No: 142/A Kadıköy" />

    <TextView
        android:id="@+id/tvPharmPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="Tel: 0216 123 45 67" />
</LinearLayout>
